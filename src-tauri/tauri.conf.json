{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TableMinus",
  "version": "0.1.0",
  "identifier": "dev.ritesh.dbmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TableMinus",
        "width": 1200,
        "height": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 13 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sqlite",
          "sqlite3",
          "db",
          "db3"
        ],
        "name": "SQLite database",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  }
}
